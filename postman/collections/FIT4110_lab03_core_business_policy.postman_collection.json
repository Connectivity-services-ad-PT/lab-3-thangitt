{
  "info": {
    "_postman_id": "fit4110-lab03-core-business-policy",
    "name": "FIT4110 Lab03 - Core Business Access Policy Tests",
    "description": "Contract tests for Pair 10: Access Gate consumes Core Business policy decisions.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const prefix = pm.environment.get('tracePrefix') || 'fit4110-lab03';",
          "pm.variables.set('correlationId', prefix + '-' + Date.now());",
          "pm.variables.set('idempotencyKey', 'idem-' + Date.now() + '-' + Math.floor(Math.random() * 100000));",
          "pm.request.headers.upsert({ key: 'X-Correlation-Id', value: pm.variables.get('correlationId') });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4010"
    },
    {
      "key": "authToken",
      "value": "lab-token"
    }
  ],
  "item": [
    {
      "name": "01_Functional",
      "item": [
        {
          "name": "GET /health - service is alive",
          "request": {
            "method": "GET",
            "header": [{ "key": "Prefer", "value": "code=200" }],
            "url": "{{baseUrl}}/health"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Health response has status and service', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.status).to.eql('ok');",
                "  pm.expect(json.service).to.be.a('string');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "POST /access/check - allow decision",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"ENTRY\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"vehiclePlate\": \"51A-12345\",\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Decision response contains required business fields', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('decisionId');",
                "  pm.expect(json).to.have.property('allow');",
                "  pm.expect(json).to.have.property('reasonCode');",
                "  pm.expect(json.gateId).to.match(/^GATE-[0-9]{2}$/);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "GET /policies/access - list policies",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": "{{baseUrl}}/policies/access?gateId=GATE-01&limit=5"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Policies response is paginated', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.items).to.be.an('array');",
                "  pm.expect(json).to.have.property('hasMore');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "GET /policies/access/{policyId} - policy detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": "{{baseUrl}}/policies/access/POL-STAFF-PARKING"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Policy detail contains gates and directions', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('policyId');",
                "  pm.expect(json).to.have.property('allowedGateIds');",
                "  pm.expect(json).to.have.property('allowedDirections');",
                "});"
              ]
            }
          }]
        },
        {
          "name": "GET /decisions - list recent decisions",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": "{{baseUrl}}/decisions?gateId=GATE-01&limit=5"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('Decision list can be parsed', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.items).to.be.an('array');",
                "  pm.expect(json).to.have.property('nextCursor');",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "02_Auth",
      "item": [
        {
          "name": "POST /access/check - missing token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"ENTRY\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Missing token is enforced on local service or documented as Prism limitation', function () {",
                "  if (pm.environment.get('env') === 'mock') { pm.expect([200, 401, 403]).to.include(pm.response.code); }",
                "  else { pm.expect([401, 403]).to.include(pm.response.code); }",
                "});"
              ]
            }
          }]
        },
        {
          "name": "POST /access/check - invalid token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer invalid-token" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"ENTRY\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Invalid token is enforced on local service or documented as Prism limitation', function () {",
                "  if (pm.environment.get('env') === 'mock') { pm.expect([200, 401, 403]).to.include(pm.response.code); }",
                "  else { pm.expect([401, 403]).to.include(pm.response.code); }",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "03_Negative",
      "item": [
        {
          "name": "POST /access/check - missing gateId",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Prefer", "value": "code=400" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"direction\": \"ENTRY\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Invalid payload returns client error', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                "pm.test('Error response follows Problem Details', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('title');",
                "  pm.expect(json.status).to.be.within(400, 599);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "POST /access/check - invalid direction enum",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Prefer", "value": "code=422" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"SIDEWAYS\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Invalid enum returns 422 or 400', function () { pm.expect([400, 422]).to.include(pm.response.code); });",
                "pm.test('Problem status is client error', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.status).to.be.within(400, 499);",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "04_Boundary_Reliability",
      "item": [
        {
          "name": "GET /policies/access - limit upper boundary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "url": "{{baseUrl}}/policies/access?limit=100"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Boundary limit is accepted', function () { pm.response.to.have.status(200); });",
                "pm.test('Returned page stays within limit', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.items.length).to.be.at.most(100);",
                "});"
              ]
            }
          }]
        },
        {
          "name": "POST /access/check - duplicate idempotency conflict",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "fixed-duplicate-key-001" },
              { "key": "Prefer", "value": "code=409" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-01\",\n  \"direction\": \"ENTRY\",\n  \"occurredAt\": \"2026-06-14T13:01:00Z\",\n  \"credential\": {\n    \"credentialType\": \"CARD\",\n    \"cardId\": \"CARD-2026-000123\"\n  },\n  \"requestedByDeviceId\": \"DEVICE-GATE-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Duplicate idempotency key can be reported as conflict', function () { pm.expect([200, 409]).to.include(pm.response.code); });",
                "pm.test('Conflict response is Problem Details when returned', function () {",
                "  if (pm.response.code === 409) { const json = pm.response.json(); pm.expect(json.status).to.be.within(400, 599); }",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "05_Consumer_side_Smoke",
      "item": [
        {
          "name": "Access Gate smoke - consume Core policy decision",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{authToken}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "Prefer", "value": "code=200" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateId\": \"GATE-02\",\n  \"direction\": \"EXIT\",\n  \"occurredAt\": \"2026-06-14T13:03:00Z\",\n  \"credential\": {\n    \"credentialType\": \"PLATE\",\n    \"plateNumber\": \"30F-88888\"\n  },\n  \"vehiclePlate\": \"30F-88888\",\n  \"requestedByDeviceId\": \"DEVICE-GATE-02\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/access/check",
            "description": "Consumer-side smoke test: Access Gate validates the minimum Core Business decision contract."
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test('Consumer receives decision from provider mock', function () { pm.response.to.have.status(200); });",
                "pm.test('Consumer can parse allow/deny and expiry', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('allow');",
                "  pm.expect(json).to.have.property('expiresAt');",
                "});"
              ]
            }
          }]
        }
      ]
    },
    {
      "name": "06_Local_only_NonFunctional",
      "item": [
        {
          "name": "GET /health - local response time budget",
          "request": {
            "method": "GET",
            "header": [{ "key": "Prefer", "value": "code=200" }],
            "url": "{{baseUrl}}/health"
          },
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "if (pm.environment.get('env') === 'local') {",
                "  pm.test('Local service responds below 1000ms', function () { pm.expect(pm.response.responseTime).to.be.below(1000); });",
                "} else {",
                "  pm.test('Latency SLA is skipped on Prism mock', function () { pm.expect(pm.environment.get('env')).to.eql('mock'); });",
                "}"
              ]
            }
          }]
        }
      ]
    }
  ]
}
